# Source notebooks and Python remain visible to reviewers and language statistics.
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.ipynb text eol=lf

# Reproducible report exports are evidence, not independently authored source code.
reports/**/*.html linguist-generated=true
reports/**/*.svg linguist-generated=true
reports/**/*.json linguist-generated=true
uv.lock linguist-generated=true

# Do not hide the executed notebook demonstrations as generated content.
notebooks/*.ipynb linguist-generated=false
reports/**/*.ipynb linguist-generated=false
